{
  "name": "my_new_place",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Skills-evidence discovery tool: map your skills and CV to a role and see the gap.",
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "db:local": "wrangler d1 migrations apply my_new_place --local --persist-to .wrangler/state",
    "db:remote": "wrangler d1 migrations apply my_new_place --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
